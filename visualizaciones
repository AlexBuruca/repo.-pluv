<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gráfica del Pluviómetro</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
        }
        h1 {
            color: #2c3e50;
        }
        canvas {
            max-width: 900px;
            margin: 20px auto;
        }
    </style>
</head>
<body>
    <h1>📊 Registro del Pluviómetro</h1>
    <canvas id="pluviometroChart"></canvas>

    <script>
        async function loadData() {
            const response = await fetch('../data/pluviometro.csv');
            const data = await response.text();

            const rows = data.split('\n').slice(1); // Ignora cabeceras
            const timestamps = [];
            const nivelAgua = [];
            const temperatura = [];
            const humedad = [];

            rows.forEach(row => {
                const cols = row.split(',');
                if(cols.length === 4){ // evita filas vacías
                    timestamps.push(cols[0]);
                    nivelAgua.push(parseFloat(cols[1]));
                    temperatura.push(parseFloat(cols[2]));
                    humedad.push(parseFloat(cols[3]));
                }
            });

            return { timestamps, nivelAgua, temperatura, humedad };
        }

        async function createChart() {
            const data = await loadData();

            const ctx = document.getElementById('pluviometroChart').getContext('2d');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.timestamps,
                    datasets: [
                        {
                            label: 'Nivel de Agua (mm)',
                            data: data.nivelAgua,
                            borderColor: 'blue',
                            backgroundColor: 'rgba(0,0,255,0.1)',
                            fill: false,
                            tension: 0.2,
                            yAxisID: 'y1'
                        },
                        {
                            label: 'Temperatura (°C)',
                            data: data.temperatura,
                            borderColor: 'red',
                            backgroundColor: 'rgba(255,0,0,0.1)',
                            fill: false,
                            tension: 0.2,
                            yAxisID: 'y2'
                        },
                        {
                            label: 'Humedad Relativa (%)',
                            data: data.humedad,
                            borderColor: 'green',
                            backgroundColor: 'rgba(0,255,0,0.1)',
                            fill: false,
                            tension: 0.2,
                            yAxisID: 'y2'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    stacked: false,
                    plugins: {
                        tooltip: {
                            enabled: true
                        },
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    },
                    scales: {
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Nivel de Agua (mm)'
                            }
                        },
                        y2: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Temperatura (°C) / Humedad (%)'
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    }
                }
            });
        }

        createChart();
    </script>
</body>
</html>
